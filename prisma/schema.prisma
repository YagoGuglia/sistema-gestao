// schema.prisma - Vitrinia Core Model v2.3 (Multi-tenant SaaS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  TENANT
  CUSTOMER
}

// -------------------------------------------------------------
// Enums de domínio (usados nas tabelas abaixo)
// -------------------------------------------------------------
enum Plan {
  FREE
  PRO
}

enum BusinessType {
  PRODUCTS
  SERVICES
  BOTH
}

enum GatewayProvider {
  MERCADO_PAGO
  PABANK
  ASAAS
  STRIPE
  NONE   // para o plano FREE sem integração automática
}

enum PaymentMethod {
  PIX
  MONEY
  CARD_DEBIT
  CARD_CREDIT
}

enum PaymentTiming {
  NOW_PIX   // paga imediatamente via Pix
  ON_SITE   // paga na entrega/retirada
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  COMPLETED
  CANCELED
  REFUNDED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  // Plano do cliente (FREE ou PRO) – controla os paywalls no front‑end
  plan      Plan     @default(FREE)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  users        User[]
  staff        Staff[]
  products     Product[]
  orders       Order[]
  expenses     Expense[]
  settings     GlobalSettings?
  stockLogs    StockLog[]
  appointments Appointment[]
  coupons      Coupon[]
  reviews      Review[]
}

model User {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  email    String? @unique
  phone    String
  role     Role    @default(CUSTOMER)
  password String?

  // Perfil enriquecido
  avatarUrl String?
  birthDate DateTime?

  // CRM / Dados Fiscais
  personType String  @default("PF")
  document   String?
  tradeName  String?

  // Endereco legacy (mantido para retrocompatibilidade)
  address      String?
  neighborhood String?
  city         String?

  // Relacoes
  addresses    CustomerAddress[]
  orders       Order[]
  appointments Appointment[]
  reviews      Review[]

  createdAt DateTime @default(now())

  @@unique([tenantId, phone])
}

// Multiplos enderecos por cliente (preenchidos via ViaCEP)
model CustomerAddress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String  @default("Casa")
  zipCode      String
  street       String
  number       String
  complement   String? @default("")
  neighborhood String
  city         String
  state        String
  isDefault    Boolean @default(false)

  orders    Order[]
  createdAt DateTime @default(now())
}

model Staff {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  roleTitle      String  @default("Atendente")
  commissionRate Float   @default(0)
  isActive       Boolean @default(true)

  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  price         Float
  costPrice     Float   @default(0)
  stock         Float   @default(0)
  minStock      Float   @default(10)
  unit          String  @default("UN")
  image         String?
  isRawMaterial Boolean @default(false)
  isService     Boolean @default(false)
  durationMin   Int?    @default(30)

  ingredients ProductIngredient[] @relation("ProductToIngredient")
  usedIn      ProductIngredient[] @relation("IngredientInProduct")

  stockLogs  StockLog[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
}

model StockLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityChange Float
  type           String
  justification  String

  createdAt DateTime @default(now())
}

model ProductIngredient {
  id String @id @default(uuid())

  productId String
  product   Product @relation("ProductToIngredient", fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Product @relation("IngredientInProduct", fields: [ingredientId], references: [id])

  quantity Float
}

model GlobalSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidade & Marca
  companyName            String  @default("Minha Loja")
  companyLogoUrl         String?
  logoUrl                String?
  bannerUrl              String?
  superBannerUrl         String?
  promoBannerUrl         String?
  primaryColor           String  @default("#7C3AED")
  storeFontFamily        String  @default("Inter")
  storeSlogan            String? @default("O SEU PEDIDO EM UM CLIQUE")
  bannerOpacity          Float   @default(1.0)
  useSolidColorForHeader Boolean @default(false)
  storeNameColor         String? @default("#FFFFFF")
  storeSloganColor       String? @default("#FFFFFF")
  // Tipo de negócio (usado para habilitar / desabilitar recursos)
  businessType   BusinessType @default(BOTH)

  // Legacy
  defaultMinStock    Float  @default(10)
  decimalSeparator   String @default(".")
  defaultDeliveryFee Float  @default(0)

  // Horarios de Funcionamento
  openingTime    String? @default("08:00")
  closingTime    String? @default("18:00")
  workDays       String? @default("DOM,SEG,TER,QUA,QUI,SEX,SAB")
  operatingHours String? @default("[{\"start\":\"08:00\",\"end\":\"18:00\"}]")
  isStoreOpen    Boolean @default(true)
  isRegisterOpen Boolean @default(false)

  // Regras de Agendamento & Cancelamento
  defaultSchedulingEnabled  Boolean @default(true)
  schedulingAppliesTo       String  @default("BOTH")
  deliverySchedulingEnabled Boolean @default(true)
  slotIntervalMin           Int     @default(30)
  depositType               String  @default("OFF")
  depositPercentage         Float   @default(0)
  cancellationHoursLimit    Int     @default(2)
  schedulingDays            String? @default("SEG,TER,QUA,QUI,SEX,SAB")
  schedulingStartTime       String? @default("08:00")
  schedulingEndTime         String? @default("18:00")
  schedulingPeriod          String? @default("ALWAYS")

  // Modulo de Comissoes
  enableCommissions Boolean @default(false)

  // Integracoes de Gateway
  gatewayProvider     GatewayProvider?
  gatewayAccessToken  String?
  pixKey              String?
  whatsappNumber      String?
  autoWhatsappEnabled Boolean @default(true)

  // Alertas Sonoros de Novos Pedidos
  // 0 = tocar 1x | 10 = repetir a cada 10s | 30 = a cada 30s | 60 = a cada 1min
  notificationAudioInterval Int @default(0)

  // Templates de mensagens WhatsApp (JSON)
  // Keys: orderConfirmed, orderPreparing, orderReady, orderDelivery, orderCancelled,
  //       appointmentConfirmed, appointmentReminder, appointmentCancelled
  // Variáveis: {{clientName}}, {{orderCode}}, {{totalAmount}}, {{storeName}},
  //            {{scheduledAt}}, {{storePhone}}, {{receiptUrl}}, {{items}}
  whatsappTemplates String?

  updatedAt DateTime @default(now())
}

model Expense {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  description String
  amount      Float
  category    String
  dueDate     DateTime
  paidAt      DateTime?

  createdAt DateTime @default(now())
}

model Order {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  totalAmount   Float
  depositAmount Float   @default(0)
  // Status do pedido – enum para consistência
  status        OrderStatus @default(PENDING)
  isManual      Boolean @default(false)

  orderType String @default("RETIRADA") // RETIRADA, DELIVERY

  // Endereco de entrega estruturado (referencia ao CustomerAddress salvo)
  customerAddressId String?
  customerAddress   CustomerAddress? @relation(fields: [customerAddressId], references: [id])

  // Campos de endereco inline (para clientes sem cadastro ou legado)
  deliveryStreet       String?
  deliveryNumber       String?
  deliveryComplement   String?
  deliveryNeighborhood String?
  deliveryCity         String?
  deliveryState        String?
  deliveryZipCode      String?

  // Pagamento — independente do tipo de pedido
  // paymentTiming: "NOW_PIX" = pagar agora via Pix | "ON_SITE" = pagar na entrega/retirada
  paymentTiming PaymentTiming @default(ON_SITE)
  // paymentMethod: "PIX", "MONEY", "CARD_DEBIT", "CARD_CREDIT"
  paymentMethod PaymentMethod @default(PIX)
  changeAmount  Float? // Troco solicitado (quando paymentMethod = MONEY)

  pixPaymentId String?
  pixQrCode    String?
  scheduledAt  DateTime?
  deliveryFee  Float     @default(0)
  observation  String?

  items       OrderItem[]
  appointment Appointment?

  createdAt DateTime @default(now())
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  price       Float
  costPrice   Float    @default(0)
  observation String?
  createdAt   DateTime @default(now())
}

model Appointment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  commission Float    @default(0)
}

model Review {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rating      Int
  comment     String?
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
}

model Coupon {
  id       String @id @default(uuid())
  code     String
  discount Float
  type     String  @default("PERCENTAGE")

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, code])
}
