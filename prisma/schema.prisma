// schema.prisma - Vitrinia Core Model v2.2 (SaaS Direto)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPERADMIN
  TENANT
  CUSTOMER
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // URL path: /loja/{slug}
  plan      String   @default("FREE")
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())

  users        User[]
  staff        Staff[]
  products     Product[]
  orders       Order[]
  expenses     Expense[]
  settings     GlobalSettings?
  stockLogs    StockLog[]
  appointments Appointment[]
  coupons      Coupon[]
  reviews      Review[]
}

model User {
  id       String  @id @default(uuid())
  tenantId String? // Pode ser nulo se for um SUPERADMIN
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  email    String? @unique
  phone    String // Não é mais unique globalmente, pois o mesmo cliente pode comprar em duas lojas diferentes
  role     Role    @default(CUSTOMER)
  password String? // Hash da senha (para Lojistas/Supabase Auth)

  // CRM / Dados Fiscais
  personType String  @default("PF") // "PF" ou "PJ"
  document   String? // CPF ou CNPJ
  tradeName  String? // Nome Fantasia (apenas PJ)

  // Endereço para Delivery
  address      String?
  neighborhood String?
  city         String?

  orders       Order[]
  appointments Appointment[]
  reviews      Review[]

  createdAt DateTime @default(now())

  // Um cliente pode usar o mesmo telefone na mesma loja, mas não dois clientes com o mesmo telefone na mesma loja.
  @@unique([tenantId, phone])
}

model Staff {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  roleTitle      String  @default("Atendente") // "Prestador de Serviço", "Vendedor", "Entregador", "Ajudante", "Gerente"
  commissionRate Float   @default(0)           // Porcentagem de comissão (ex: 10.0 para 10%)
  isActive       Boolean @default(true)

  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  price         Float   // Preço de Venda
  costPrice     Float   @default(0) // Preço de Custo
  stock         Float   @default(0)
  minStock      Float   @default(10)
  image         String?
  isRawMaterial Boolean @default(false)
  isService     Boolean @default(false) // True = Serviço (aparece na vitrine de serviços)
  durationMin   Int?    @default(30)    // Duração do serviço em minutos

  ingredients ProductIngredient[] @relation("ProductToIngredient")
  usedIn      ProductIngredient[] @relation("IngredientInProduct")

  stockLogs  StockLog[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
}

model StockLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantityChange Float
  type           String // "MANUAL", "SALE", "BOM_CONSUMPTION"
  justification  String

  createdAt DateTime @default(now())
}

model ProductIngredient {
  id String @id @default(uuid())

  productId String
  product   Product @relation("ProductToIngredient", fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Product @relation("IngredientInProduct", fields: [ingredientId], references: [id])

  quantity Float
}

model GlobalSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidade & Marca
  companyName    String  @default("Minha Loja")
  companyLogoUrl String?
  bannerUrl      String?
  primaryColor   String  @default("#7C3AED") // Cor de destaque da vitrine
  businessType   String  @default("BOTH")    // "PRODUCTS", "SERVICES", "BOTH"

  // Legacy (mantidos para compatibilidade)
  defaultMinStock    Float  @default(10)
  decimalSeparator   String @default(".")
  defaultDeliveryFee Float  @default(0)

  // Horários de Funcionamento
  openingTime String? @default("08:00")
  closingTime String? @default("18:00")
  workDays    String? @default("MON,TUE,WED,THU,FRI,SAT")

  // Regras de Agendamento & Cancelamento
  defaultSchedulingEnabled Boolean @default(true)
  depositType              String  @default("OFF") // "OFF", "PARTIAL", "FULL"
  depositPercentage        Float   @default(0)     // ex: 20 para 20%
  cancellationHoursLimit   Int     @default(2)     // Prazo limite para cancelamento (horas)

  // Módulo de Comissões
  enableCommissions Boolean @default(false)

  // Integrações de Gateway do Lojista (Credenciais Próprias)
  gatewayProvider     String? // "MERCADOPAGO", "ASAAS", "EFI"
  gatewayAccessToken  String? // Token/Key da conta do lojista
  pixKey              String?
  whatsappNumber      String?
  autoWhatsappEnabled Boolean @default(true)

  updatedAt DateTime @default(now())
}

model Expense {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  description String
  amount      Float
  category    String   // "ALUGUEL", "ENERGIA", "INSUMOS", "SALARIO", "OUTROS"
  dueDate     DateTime
  paidAt      DateTime?

  createdAt DateTime @default(now())
}

model Order {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  totalAmount   Float
  depositAmount Float   @default(0)
  status        String  @default("PENDING") // PENDING, PAID, REFUNDED, COMPLETED, CANCELLED
  isManual      Boolean @default(false)

  orderType     String    @default("RETIRADA") // RETIRADA, DELIVERY
  paymentMethod String    @default("PIX")      // PIX, CREDIT_CARD, DEBIT_CARD, MONEY
  pixPaymentId  String?   // ID da transação no Gateway do Lojista para acionar o refund
  pixQrCode     String?
  scheduledAt   DateTime?
  deliveryFee   Float     @default(0)
  observation   String?

  items       OrderItem[]
  appointment Appointment?

  createdAt DateTime @default(now())
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Int
  price       Float
  costPrice   Float    @default(0) // Custo no momento da venda para relatórios
  observation String?
  createdAt   DateTime @default(now())
}

model Appointment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  startTime  DateTime
  endTime    DateTime
  status     String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELED
  notes      String?
  commission Float    @default(0) // Valor de comissão calculado para este atendimento
}

model Review {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rating      Int     // 1 a 5
  comment     String?
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
}

model Coupon {
  id       String @id @default(uuid())
  code     String
  discount Float // percentage or fixed value
  type     String @default("PERCENTAGE") // PERCENTAGE or FIXED

  // Se tenantId for nulo, o cupom é da plataforma (Super Admin).
  // Se preenchido, é um cupom da loja para os clientes dela.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  // O código deve ser único por loja (tenantId + code)
  @@unique([tenantId, code])
}
